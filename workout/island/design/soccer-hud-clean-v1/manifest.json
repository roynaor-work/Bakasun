    "strings": {
      "controlled": "השחקן הנשלט",
      "open": "חופשי",
      "nearest": "קרוב לכדור",
      "shotPower": "עוצמת בעיטה",
      "offscreen": "הכדור מחוץ למסך",
      "home": "בית",
      "away": "חוץ"
    },
    "scoreboard": "HTML or game text; isolate each team name with bdi dir=rtl; score and MM:SS in bdi dir=ltr. No text is part of a sprite."
  },
  "behavior": {
    "controlled": "Exactly one ground ring and one overhead arrow. The three ring variants keep the same canvas scale.",
    "pass": "Show while aiming; low [0,1/3), medium [1/3,2/3), high [2/3,1]. One/two/three tail ticks also encode intensity.",
    "open": "One suggested eligible teammate at a time; only if unmarked and a clear passing lane. Suppress on controlled player.",
    "nearest": "Mark the closest visible player to the ball, including opponents; suppress when that player is controlled. Use 0.4m advantage for 150ms before switching.",
    "shot": "Track and clipped fill beside controlled player only while charging. Clip fill in canvas coordinates; clamp 0..1.",
    "offscreen": "Hide for visible ball. Intersect direction ray with safe viewport rectangle; do not clamp x/y independently. Clamp center using 34px padding or device safe inset +20px, whichever is larger. Reserve top-left score area and bottom control areas.",
    "scoreboard": "240x56 logical panel at [16,12]. Clock is a match-state value; paused time does not advance."
  },
