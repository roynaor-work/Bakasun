  "semantics": {
    "priority": "Evaluate highest priority first; equal priority uses array order. First eligible transition wins. * matches every state except target. fall_confirmed is ignored while fall/recover; result_success is ignored while fall/recover/celebrate. reset always wins.",
    "events": "Events are presentation markers only. Never apply physics, score, ownership or rewards from clip time. clip_finished is emitted once for non-looping clips; moving/stopped come from the authoritative snapshot.",
    "pause": "Freeze mixer time and pending presentation events; resume without elapsed wall-clock catch-up.",
    "reducedMotion": "Keep contact poses and durations; suppress camera shake, FOV pulse and celebration bounce.",
    "interrupt": "fall may interrupt action or receive. Reset clears queued markers; no duplicate contact events.",
    "turn": "Left/right are anatomical, never RTL mirrored. World rotation comes from simulation; clips stay in place."
  },
  "eventInputs": [
