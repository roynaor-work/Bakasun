diff --git a/workout/js/camera-v1/capture.mjs b/workout/js/camera-v1/capture.mjs
new file mode 100644
index 0000000..b434711
--- /dev/null
+++ b/workout/js/camera-v1/capture.mjs
@@ -0,0 +1,100 @@
+const PERIOD_MS = 62;
+const FRAME_TIMEOUT_MS = 5000;
+const START_TIMEOUT_MS = 25000;
+const stopTracks = stream => stream?.getTracks().forEach(track => track.stop());
+
+export class LocalCapture {
+  constructor(video, { onPose, onReady, onError }) {
+    this.video = video;
+    this.onPose = onPose;
+    this.onReady = onReady;
+    this.onError = onError;
+    this.cancelled = false;
+    this.lastFrame = -1;
+  }
+
+  async start() {
+    this.watchdog = setTimeout(() => this.fail('timeout'), START_TIMEOUT_MS);
+    try {
+      const stream = await navigator.mediaDevices.getUserMedia({
+        audio: false,
+        video: { facingMode: { ideal: 'user' }, width: { ideal: 640 }, height: { ideal: 480 }, frameRate: { ideal: 24, max: 30 } },
+      });
+      if (this.cancelled) { stopTracks(stream); return; }
+      this.stream = stream;
+      for (const track of stream.getVideoTracks()) track.addEventListener('ended', () => this.fail('ended'), { once: true });
+      this.video.srcObject = stream;
+      await this.video.play();
+      if (this.cancelled) return;
+      this.worker = new Worker(new URL('./pose-worker.js', import.meta.url));
+      this.worker.onmessage = ({ data }) => this.receive(data);
+      this.worker.onerror = () => this.fail('worker');
+      this.worker.onmessageerror = () => this.fail('worker');
+      this.worker.postMessage({ type: 'init' });
+    } catch (error) {
+      this.fail(error.name === 'NotAllowedError' || error.name === 'SecurityError' ? 'permission' : 'unavailable');
+    }
+  }
+
+  receive(data) {
+    if (this.cancelled) return;
+    clearTimeout(this.watchdog);
+    if (data.type === 'ready') {
+      this.onReady();
+      this.schedule(FRAME_TIMEOUT_MS);
+    } else if (data.type === 'pose') {
+      this.onPose(data);
+      this.schedule(FRAME_TIMEOUT_MS);
+    } else {
+      this.fail('worker');
+    }
+  }
+
+  schedule(timeout) {
+    if (this.cancelled) return;
+    this.watchdog = setTimeout(() => this.fail('timeout'), timeout);
+    this.tick = setTimeout(() => this.frame(), PERIOD_MS);
+  }
+
+  async frame() {
+    if (this.cancelled) return;
+    const { videoWidth, videoHeight, currentTime } = this.video;
+    if (!videoWidth || !videoHeight || this.lastFrame === currentTime) {
+      this.tick = setTimeout(() => this.frame(), PERIOD_MS);
+      return;
+    }
+    this.lastFrame = currentTime;
+    const time = performance.now();
+    let bitmap;
+    try {
+      const scale = Math.min(1, 640 / Math.max(videoWidth, videoHeight));
+      bitmap = await createImageBitmap(this.video, { resizeWidth: Math.round(scale * videoWidth), resizeHeight: Math.round(scale * videoHeight) });
+      if (!this.cancelled) {
+        this.worker.postMessage({ type: 'frame', time, bitmap }, [bitmap]);
+        bitmap = null;
+      }
+    } catch {
+      this.fail('worker');
+    } finally {
+      bitmap?.close();
+    }
+  }
+
+  fail(reason) {
+    if (this.cancelled) return;
+    this.close();
+    this.onError(reason);
+  }
+
+  close() {
+    if (this.cancelled) return;
+    this.cancelled = true;
+    clearTimeout(this.watchdog);
+    clearTimeout(this.tick);
+    this.worker?.terminate();
+    stopTracks(this.stream);
+    this.video.pause();
+    this.video.srcObject = null;
+    this.stream = this.worker = null;
+  }
+}
diff --git a/workout/js/camera-v1/pose-worker.js b/workout/js/camera-v1/pose-worker.js
new file mode 100644
index 0000000..9f5d7dc
--- /dev/null
+++ b/workout/js/camera-v1/pose-worker.js
@@ -0,0 +1,66 @@
+// MediaPipe uses importScripts for its existing vendored WASM loader.
+const lab = new URL('../../cam-lab/', self.location.href);
+let detector, sampler, measureLight;
+let lastTime = -Infinity;
+
+async function init() {
+  if (self.location.protocol !== 'http:' || self.location.hostname !== '127.0.0.1') {
+    throw new Error('Loopback origin required');
+  }
+  const { FilesetResolver, PoseLandmarker } = await import(new URL('vendor/vision_bundle.mjs', lab).href);
+  ({ measureLight } = await import('./tracking.mjs?v=20261010-camera-1'));
+  sampler = new OffscreenCanvas(48, 32).getContext('2d', { willReadFrequently: true });
+  const files = await FilesetResolver.forVisionTasks(new URL('vendor/wasm', lab).href);
+  detector = await PoseLandmarker.createFromOptions(files, {
+    baseOptions: { modelAssetPath: new URL('models/pose_landmarker_lite.task', lab).href, delegate: 'CPU' },
+    canvas: new OffscreenCanvas(640, 640),
+    runningMode: 'VIDEO',
+    numPoses: 2,
+    minPoseDetectionConfidence: 0.45,
+    minPosePresenceConfidence: 0.45,
+    minTrackingConfidence: 0.5,
+    outputSegmentationMasks: false,
+  });
+  self.postMessage({ type: 'ready' });
+}
+
+function lightAt(bitmap, poses) {
+  let region;
+  if (poses.length === 1) {
+    const points = [0, 7, 8, 11, 12, 23, 24].map(index => poses[0].landmarks[index])
+      .filter(p => p?.visibility >= 0.5);
+    if (points.length >= 3) {
+      const x = points.map(p => p.x);
+      const y = points.map(p => p.y);
+      region = { left: Math.min(...x) - .02, right: Math.max(...x) + .02, top: Math.min(...y) - .02, bottom: Math.max(...y) };
+    }
+  }
+  try {
+    sampler.drawImage(bitmap, 0, 0, 48, 32);
+    return measureLight(sampler.getImageData(0, 0, 48, 32).data, { width: 48, height: 32, region });
+  } finally {
+    sampler.clearRect(0, 0, 48, 32);
+  }
+}
+
+self.onmessage = async ({ data }) => {
+  if (data.type === 'init') {
+    try { await init(); }
+    catch { self.postMessage({ type: 'error' }); }
+    return;
+  }
+  const { bitmap, time } = data;
+  if (!bitmap) return;
+  try {
+    if (!detector || !Number.isFinite(time) || time <= lastTime) throw new Error('Invalid frame');
+    lastTime = time;
+    const aspect = bitmap.width / bitmap.height;
+    const result = detector.detectForVideo(bitmap, time);
+    const poses = result.landmarks.map((landmarks, index) => ({ landmarks, world: result.worldLandmarks[index] || [] }));
+    self.postMessage({ type: 'pose', time, light: lightAt(bitmap, poses), aspect, poses });
+  } catch {
+    self.postMessage({ type: 'error' });
+  } finally {
+    bitmap.close();
+  }
+};
diff --git a/workout/js/camera-v1/session.mjs b/workout/js/camera-v1/session.mjs
