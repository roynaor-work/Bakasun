@@ -0,0 +1,79 @@
+const LEFT = { shoulder: 11, elbow: 13, wrist: 15, hip: 23, knee: 25, ankle: 27, heel: 29, toe: 31 };
+const RIGHT = { shoulder: 12, elbow: 14, wrist: 16, hip: 24, knee: 26, ankle: 28, heel: 30, toe: 32 };
+const SIDES = [LEFT, RIGHT];
+
+export const either = (...joints) => SIDES.map(side => joints.map(name => side[name]));
+export const both = (...joints) => either(...joints).flat();
+const CONFIDENCE = .35;
+export const observed = p => p && Number.isFinite(p.x) && Number.isFinite(p.y) &&
+  p.x >= 0 && p.x <= 1 && p.y >= 0 && p.y <= 1 &&
+  (p.visibility ?? 0) >= CONFIDENCE && (p.presence ?? 1) >= CONFIDENCE;
+
+export function seen(points, required) {
+  return (Array.isArray(required[0]) ? required : [required]).some(set => set.every(i => observed(points?.[i])));
+}
+
+function mean(a, b) {
+  if (!a || !b) return a || b;
+  return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
+}
+
+function distance(a, b) {
+  return a && b ? Math.hypot(a.x - b.x, a.y - b.y) : NaN;
+}
+
+function angle(a, b, c) {
+  const u = distance(a, b), v = distance(c, b);
+  if (!(u > .0001 && v > .0001)) return NaN;
+  const dot = (a.x - b.x) * (c.x - b.x) + (a.y - b.y) * (c.y - b.y);
+  return Math.acos(Math.max(-1, Math.min(1, dot / (u * v)))) * 180 / Math.PI;
+}
+
+const finite = values => values.filter(Number.isFinite);
+export const max = values => finite(values).length ? Math.max(...finite(values)) : NaN;
+export const min = values => finite(values).length ? Math.min(...finite(values)) : NaN;
+
+export function measure(points, aspect, reference, required) {
+  const p = points.map(q => observed(q) ? { x: q.x * aspect, y: q.y } : null);
+  const sides = SIDES.map((ids, index) => {
+    const j = Object.fromEntries(Object.entries(ids).map(([name, i]) => [name, p[i]]));
+    return { ...j, index, score: Object.values(ids).reduce((value, i) => value + (p[i] ? points[i].visibility : 0), 0),
+      complete: !required || !Array.isArray(required[0]) || required[index].every(i => p[i]) };
+  });
+  const [left, right] = sides;
+  const main = sides.filter(side => side.complete).sort((a, b) => b.score - a.score)[0];
+  const hip = mean(left.hip, right.hip), shoulder = mean(left.shoulder, right.shoulder);
+  if (!main || !hip || !shoulder) return null;
+  const s = reference?.scale ?? distance(main.shoulder || shoulder, main.hip || hip);
+  if (!(s >= .035)) return null;
+  const dx = (a, b) => a && b ? (a.x - b.x) / s : NaN;
+  const dy = (a, b) => a && b ? (a.y - b.y) / s : NaN;
+  const dist = (a, b) => distance(a, b) / s;
+  for (const side of sides) {
+    const { shoulder, elbow, wrist, hip, knee, ankle, toe, heel } = side;
+    side.kneeAngle = angle(hip, knee, ankle);
+    side.elbowAngle = angle(shoulder, elbow, wrist);
+    side.line = angle(shoulder, hip, ankle);
+    side.kneeLine = angle(shoulder, hip, knee);
+    side.legAngle = angle(shoulder, hip, knee);
+    side.torsoLength = dist(shoulder, hip);
+    side.sole = max([toe?.y, heel?.y, ankle ? ankle.y + .08 * s : NaN]);
+    side.armUp = dy(shoulder, wrist);
+    side.heelRise = dy(toe, heel);
+    side.kneeRise = dy(hip, knee);
+  }
+  const floor = reference?.floor ?? max(sides.map(side => side.sole));
+  const clearance = y => (floor - y) / s;
+  for (const side of sides) side.clearance = clearance(side.sole);
+  const footLift = min(sides.map(side => side.clearance));
+  const kneeLift = max(sides.map(side => side.kneeRise));
+  const feet = Math.abs(dx(left.ankle, right.ankle));
+  const shoulders = Math.abs(dx(left.shoulder, right.shoulder));
+  const face = p[0] && p[7] && p[8] ? dx(p[0], mean(p[7], p[8])) : dx(p[0], shoulder);
+  return { left, right, sides, main, hip, shoulder, nose: p[0], scale: s, floor, face, dx, dy, dist,
+    footLift, kneeLift, feet, shoulders, clearance, hipRise: reference ? dy(reference.hip, hip) : 0,
+    torsoUp: dy(hip, shoulder), torsoWide: Math.abs(dx(hip, shoulder)),
+    kneeWidth: Math.abs(dx(left.knee, right.knee)), wristSpread: Math.abs(dx(left.wrist, right.wrist)),
+    ankleOrder: Math.sign(dx(left.ankle, right.ankle)), bodyLine: main.line, kneeLine: main.kneeLine,
+    kneeAngle: main.kneeAngle, elbowAngle: main.elbowAngle };
+}
diff --git a/workout/js/camera-v1/hall.mjs b/workout/js/camera-v1/hall.mjs
new file mode 100644
index 0000000..672730b
--- /dev/null
+++ b/workout/js/camera-v1/hall.mjs
@@ -0,0 +1,116 @@
+// Estimate visible movement along the camera plane. No scene geometry or wall
+// contact follows from body landmarks, even if a reach or landing is visible.
+const STABLE_WINDOW = 250;
+const MAX_PASS = 14000;
+
+function newPass(origin, f, time) {
+  return { origin, since: time, direction: Math.sign(f.dx(f.hip, origin.hip)), strides: 0,
+    flights: 0, forwardJump: false, reachJump: false, reached: false, lowStart: false,
+    crosses: 0, bent: 0, skips: 0, backwards: 0, away: 0, widths: 0, farthest: 0 };
+}
+
+function legCue(f) {
+  const high = f.sides.find(side => side.kneeRise > -.58 &&
+    side.kneeRise - f.sides[1 - side.index].kneeRise > .19);
+  return high?.index;
+}
+
+function inspect(pass, f, time) {
+  const { direction } = pass;
+  const progress = f.dx(f.hip, pass.origin.hip) * direction;
+  pass.farthest = Math.max(pass.farthest, progress);
+  const raised = legCue(f);
+  if (raised != null && raised !== pass.lastLeg) {
+    pass.strides++;
+    pass.lastLeg = raised;
+    if (f.face * direction < -.085) pass.backwards++;
+    if (f.face * direction > .085) pass.away++;
+  }
+  // A sideways step shows alternating open/close foot spacing even when
+  // neither knee is raised high enough to look like a forward stride.
+  const width = f.feet > .98 ? 'wide' : f.feet < .71 ? 'narrow' : null;
+  if (width && width !== pass.lastWidth) {
+    pass.lastWidth = width;
+    if (width === 'wide') pass.widths++;
+  }
+  if (f.kneeAngle < 156 || f.hipRise < -.10 || f.feet > 1.0) pass.bent++;
+  const crossed = f.ankleOrder !== Math.sign(f.dx(f.left.hip, f.right.hip)) && f.feet > .23;
+  if (crossed && !pass.crossed) pass.crosses++;
+  pass.crossed = crossed;
+  const airborne = f.footLift > .23 && f.hipRise > .12;
+  if (airborne && !pass.airborne) {
+    pass.flights++;
+    pass.jumpStart = progress;
+  }
+  if (airborne && raised != null && raised !== pass.lastSkip && f.sides[1 - raised].armUp > .30) {
+    pass.skips++;
+    pass.lastSkip = raised;
+  }
+  if (!airborne && pass.airborne) {
+    if (progress - pass.jumpStart > .35 && pass.strides >= 2) pass.forwardJump = true;
+    if (pass.airReach && pass.strides >= 2) pass.reachJump = true;
+    pass.airReach = false;
+  }
+  if (airborne && f.sides.some(side => side.armUp > .65)) pass.airReach = true;
+  pass.airborne = airborne;
+  if (progress > 1.65 && f.sides.some(side => side.elbowAngle > 140 &&
+    f.dx(side.wrist, side.shoulder) * direction > .70)) pass.reachAt = time;
+}
+
+export class HallProgress {
+  reset() {
+    this.anchor = null;
+    this.pass = null;
+    this.still = null;
+    this.last = null;
+    this.departedAt = null;
+  }
+
+  update(f, time, spec, signalAt) {
+    const last = this.last;
+    this.last = f;
+    if (!last) return null;
+    const drift = f.dist(f.hip, last.hip);
+    const stable = drift < .047 && !(f.footLift > .18);
+    if (stable && (!this.still || f.dist(f.hip, this.still.pose.hip) > .12)) this.still = { since: time, pose: f };
+    if (!stable) this.still = null;
+    const settled = stable && time - this.still.since >= STABLE_WINDOW;
+    const lowPosition = f.sides.some(side => f.clearance(side.wrist?.y) < .24) && f.torsoUp < .48;
+    if (!this.anchor) {
+      if (settled) this.anchor = { pose: f, low: lowPosition, at: time };
+      return null;
+    }
+    const gap = f.dx(f.hip, this.anchor.pose.hip);
+    if (!this.pass && Math.abs(gap) >= .11) this.departedAt ??= time;
+    if (!this.pass && Math.abs(gap) >= .33) {
+      this.pass = newPass(this.anchor.pose, f, time);
+      this.pass.lowStart = this.anchor.low;
+      this.pass.signalled = !spec.signal || Number.isFinite(signalAt) && signalAt <= this.departedAt &&
+        signalAt >= this.anchor.at - STABLE_WINDOW;
+    }
+    if (!this.pass) {
+      if (settled && Math.abs(gap) < .11) this.departedAt = null;
+      if (lowPosition) this.anchor.low = true;
+      return null;
+    }
+    const pass = this.pass;
+    inspect(pass, f, time);
+    if (settled && Math.abs(gap) < .23 || time - pass.since > MAX_PASS) {
+      this.reset();
+      return 'partial';
+    }
+    if (gap * pass.direction < pass.farthest - .42) {
+      this.reset();
+      return 'partial';
+    }
+    if (!settled || pass.farthest < 1.82) return null;
+    if (spec.view === 'front') pass.strides = Math.max(pass.strides, pass.widths);
+    pass.reached = Number.isFinite(pass.reachAt) && time - pass.reachAt <= 790;
+    const accepted = pass.signalled && spec.condition(pass, f);
+    this.pass = null;
+    this.departedAt = null;
+    this.anchor = { pose: f, low: lowPosition, at: time };
+    if (!accepted && !spec.signal && pass.strides < 2 && pass.flights === 0 && pass.crosses === 0) return null;
+    return accepted ? 'counted' : 'partial';
+  }
+}
diff --git a/workout/js/camera-v1/motion.mjs b/workout/js/camera-v1/motion.mjs
new file mode 100644
index 0000000..6f842fd
--- /dev/null
+++ b/workout/js/camera-v1/motion.mjs
@@ -0,0 +1,265 @@
+import { measure, seen } from './geometry.mjs?v=20261010-camera-1';
+import { FORM_HINTS, PROFILES } from './profiles.mjs?v=20261010-camera-1';
+import { HallProgress } from './hall.mjs?v=20261010-camera-1';
+export { CAMERA_EXERCISES } from './profiles.mjs?v=20261010-camera-1';
+
+export const MOTION_MAX_GAP_MS = 275;
+const REST_DWELL = 84;
+const ACTIVITY_GAP = 1400;
+const COACH_MS = 950;
+const DEFAULT_CYCLE_MIN = 190;
+const TAU = Math.PI * 2;
+
+export class MotionCounter {
+  constructor(id, { goal } = {}) {
+    if (!Object.hasOwn(PROFILES, id)) throw new RangeError(`Unknown exercise: ${id}`);
+    this.spec = PROFILES[id];
+    this.goal = Number.isFinite(goal) && goal > 0 ? goal : null;
+    this.count = 0;
+    this.activeMs = 0;
+    this.sideCounts = [0, 0];
+    this.sideMs = [0, 0];
+    this.observedAt = null;
+    this.reference = null;
+    this.lastSide = null;
+    this.hall = new HallProgress();
+    this.pause();
+  }
+
+  setReference(points, { aspect = 1 } = {}) {
+    if (!seen(points, this.spec.required)) return false;
+    const f = measure(points, aspect, null, this.spec.required);
+    if (!f || this.spec.mode !== 'circles' && !Number.isFinite(f.floor)) return false;
+    this.reference = f;
+    this.pause();
+    if (this.spec.rest?.(f)) this.origin = f;
+    return true;
+  }
+
+  calibrate(points, options) { return this.setReference(points, options); }
+
+  // A beep represents local application timing, independent of the camera.
+  signal(timestamp) {
+    if (Number.isFinite(timestamp)) this.signalAt = timestamp;
+  }
+
+  pause() {
+    this.previous = null;
+    this.lastCueAt = null;
+    this.cue = null;
+    this.holding = null;
+    this.restAt = null;
+    this.origin = null;
+    this.cycle = null;
+    this.circle = null;
+    this.coachAt = null;
+    this.hall.reset();
+    this.signalAt = null;
+    this.last = null;
+    this.requireNeutral = false;
+  }
+
+  result(event = null, hint = null, side = null) {
+    return { count: this.count, activeMs: this.activeMs, event, hint, side,
+      sideCounts: [...this.sideCounts], sideMs: [...this.sideMs] };
+  }
+
+  update(points, timestamp, { aspect = 1 } = {}) {
+    if (!Number.isFinite(timestamp) || this.observedAt != null && timestamp <= this.observedAt) return this.result();
+    this.observedAt = timestamp;
+    if (!Number.isFinite(aspect) || aspect <= 0 || !seen(points, this.spec.required)) {
+      this.pause();
+      return this.result('tracking');
+    }
+    if (!this.reference && !this.setReference(points, { aspect })) return this.result('tracking');
+    if (this.previous != null && timestamp - this.previous > MOTION_MAX_GAP_MS) this.pause();
+    const gap = this.previous == null ? 0 : timestamp - this.previous;
+    const f = measure(points, aspect, this.reference, this.spec.required);
+    if (!f) { this.pause(); return this.result('tracking'); }
+    this.previous = timestamp;
+    const result = this.process(f, timestamp, gap);
+    this.last = f;
+    return result;
+  }
+
+  process(f, t, gap) {
+    switch (this.spec.mode) {
+      case 'hall': {
+        const event = this.hall.update(f, t, this.spec, this.signalAt);
+        if (event === 'counted') {
+          if (this.spec.signal) this.signalAt = null;
+          return this.creditRep(t);
+        }
+        if (event === 'partial') return this.result(event, this.spec.hint);
+        return this.result();
+      }
+      case 'hold': return this.hold(f, t, gap);
+      case 'alternating': return this.alternating(f, t);
+      case 'circles': return this.circles(f, t, gap);
+      case 'cycle': return this.cycleAt(f, t);
+      default: return this.result();
+    }
+  }
+
+  creditRep(t, side = null, activityTime = ACTIVITY_GAP) {
+    if (this.spec.twoSides && this.goal != null) {
+      if (this.sideCounts[side] >= Math.ceil(this.goal / 2)) return this.result('switch', FORM_HINTS.SIDE_SWITCH, side);
+      if (this.count >= this.goal) return this.result();
+    }
+    if (this.spec.kind === 'activity' && this.lastCueAt != null && t - this.lastCueAt <= activityTime) {
+      this.activeMs += t - this.lastCueAt;
+    }
+    this.lastCueAt = t;
+    if (side != null) this.lastSide = side;
+    if (side === 0 || side === 1) this.sideCounts[side]++;
+    this.count++;
+    return this.result('counted', null, side);
+  }
+
+  coaching(t) {
+    this.coachAt ??= t;
+    if (t - this.coachAt < COACH_MS) return this.result();
+    return this.result('guide', this.spec.hint);
+  }
+
+  hold(f, t, gap) {
+    const observation = this.spec.check(f);
+    const side = this.spec.twoSides ? observation : null;
+    const valid = this.spec.twoSides ? side === 0 || side === 1 : observation === true;
+    if (!valid) {
+      this.holding = null;
+      return this.coaching(t);
+    }
+    this.coachAt = null;
+    if (!this.holding || this.holding.side !== side) this.holding = { since: t, side };
+    if (t - this.holding.since < 240 || !gap) return this.result();
+    let credit = Math.min(gap, t - this.holding.since - 240);
+    if (side != null && this.goal != null) credit = Math.min(credit, this.goal * 500 - this.sideMs[side]);
+    if (credit <= 0) return side != null && this.goal != null && this.sideMs[side] >= this.goal * 500
+      ? this.result('switch', FORM_HINTS.SIDE_SWITCH, side) : this.result();
+    if (side != null) this.sideMs[side] += credit;
+    this.activeMs += credit;
+    return this.result('holding', null, side);
+  }
+
+  alternating(f, t) {
+    const { neutral, side: getSide, cueDwell = 65 } = this.spec;
+    if (neutral?.(f)) this.requireNeutral = false;
+    const side = getSide(f);
+    if (side !== 0 && side !== 1 || this.requireNeutral) {
+      this.cue = null;
+      return this.coaching(t);
+    }
+    if (this.cue?.side !== side) this.cue = { since: t, side };
+    if (t - this.cue.since < cueDwell || this.cue.counted) return this.result();
+    this.cue.counted = true;
+    if (side === this.lastSide) {
+      if (t - this.lastCueAt > ACTIVITY_GAP) this.lastCueAt = null;
+      return this.result('switch', FORM_HINTS.SIDE_SWITCH, side);
+    }
+    if (neutral) this.requireNeutral = true;
+    this.coachAt = null;
+    return this.creditRep(t, side);
+  }
+
+  circles(f, t, gap) {
+    const arm = f.main;
+    const x = f.dx(arm.wrist, arm.shoulder), y = f.dy(arm.wrist, arm.shoulder);
+    if (f.torsoUp < .64 || Math.hypot(x, y) < .57 || arm.elbowAngle < 135) {
+      this.circle = null;
+      return this.coaching(t);
+    }
+    const a = Math.atan2(y, x);
+    if (!this.circle || this.circle.side !== arm.index) this.circle = { angle: a, arc: 0, elapsed: 0, side: arm.index };
+    const circle = this.circle;
+    const diff = Math.atan2(Math.sin(a - circle.angle), Math.cos(a - circle.angle));
+    circle.angle = a;
+    if (Math.abs(diff) > 1.25) {
+      circle.arc = 0;
+      circle.elapsed = 0;
+      return this.result();
+    }
+    if (Math.abs(diff) < .02) return this.coaching(t);
+    if (Math.abs(circle.arc) > .12 && Math.sign(diff) !== Math.sign(circle.arc)) {
+      circle.arc = 0;
+      circle.elapsed = 0;
+    }
+    circle.arc += diff;
+    circle.elapsed += gap;
+    this.coachAt = null;
+    if (Math.abs(circle.arc) < TAU - .25) return this.result();
+    this.activeMs += circle.elapsed;
+    circle.arc = 0;
+    circle.elapsed = 0;
+    return this.creditRep(t, null, 0);
+  }
+
+  cycleAt(f, t) {
+    const spec = this.spec;
+    const rest = spec.rest(f);
+    if (this.origin == null) {
+      if (!rest) { this.restAt = null; return this.coaching(t); }
+      this.restAt ??= t;
+      if (t - this.restAt < REST_DWELL) return this.result();
+      this.origin = f;
+    }
+    const pending = this.cycle || { origin: this.origin, startSide: spec.startSide?.(this.origin), since: t,
+      index: 0, stepAt: null, peakFoot: -Infinity, leftRest: false };
+    const first = spec.steps[0];
+    if (!this.cycle && (rest || spec.waitFirst) && !first.test(f, pending)) {
+      if (rest) this.origin = f;
+      return this.result();
+    }
+    this.cycle = pending;
+    if (!rest) pending.leftRest = true;
+    pending.peakFoot = Math.max(pending.peakFoot, f.footLift);
+    const issue = spec.form?.(f);
+    if (issue) {
+      pending.issueAt ??= t;
+      if (t - pending.issueAt >= 175) pending.issue = issue;
+    } else pending.issueAt = null;
+    const step = spec.steps[pending.index];
+    const matches = step?.test(f, pending);
+    if (matches) {
+      pending.stepAt ??= t;
+      if (t - pending.stepAt >= step.dwell) {
+        pending.index++;
+        pending.stepAt = null;
+      }
+    } else if (step) pending.stepAt = null;
+    const completed = pending.index === spec.steps.length;
+    const landed = (spec.finish ? spec.finish(f, pending) : rest) &&
+      (!spec.stillFinish || this.last && f.dist(f.hip, this.last.hip) < .053);
+    if (completed && landed) {
+      pending.finishAt ??= t;
+      if (t - pending.finishAt >= (spec.finishDwell ?? 65) && t - pending.since >= (spec.minCycle ?? DEFAULT_CYCLE_MIN)) {
+        const side = spec.cycleSide?.(f, pending) ?? pending.side ?? null;
+        const event = pending.issue ? this.result('form', pending.issue, side) :
+          spec.alternate && side === this.lastSide ? this.result('switch', FORM_HINTS.SIDE_SWITCH, side) : this.creditRep(t, side);
+        this.clearCycle(spec.rearm !== false && rest, f, t);
+        return event;
+      }
+    } else pending.finishAt = null;
+    // A return to a stable starting pose without the remaining stages ends
+    // the attempt. Squat jumps can remain in the rest predicate during takeoff prep.
+    if (!completed && rest && pending.leftRest && !matches) {
+      pending.backAt ??= t;
+      if (t - pending.backAt >= 155) {
+        this.clearCycle(true, f, t);
+        return this.result('partial', pending.issue ?? spec.hint);
+      }
+    } else pending.backAt = null;
+    if (t - pending.since > (spec.maxCycle ?? 6500)) {
+      this.clearCycle(rest, f, t);
+      return this.result('partial', pending.issue ?? spec.hint);
+    }
+    return this.result();
+  }
+
+  clearCycle(rearm, pose, t) {
+    this.cycle = null;
+    this.origin = rearm ? pose : null;
+    this.restAt = rearm ? t : null;
+    this.coachAt = null;
+  }
+}
diff --git a/workout/js/camera-v1/profiles.mjs b/workout/js/camera-v1/profiles.mjs
new file mode 100644
index 0000000..f1d812e
--- /dev/null
+++ b/workout/js/camera-v1/profiles.mjs
@@ -0,0 +1,270 @@
+import { both, either, max, min } from './geometry.mjs?v=20261010-camera-1';
+
+const LEGS = ['shoulder', 'hip', 'knee', 'ankle'];
+const ARMS = ['shoulder', 'elbow', 'wrist', 'hip'];
+const BODY = ['shoulder', 'elbow', 'wrist', 'hip', 'knee', 'ankle'];
+const FEET = [...LEGS, 'heel', 'toe'];
+const ALL = [...BODY, 'heel', 'toe'];
+
+const stand = f => f.torsoUp > .65 && f.kneeAngle >= 150;
+const upright = f => f.torsoUp > .63;
