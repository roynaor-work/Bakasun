+  const percentile = (distribution, size, ratio) => {
+    const target = Math.ceil(size * ratio);
+    let sum = 0;
+    for (let level = 0; level < distribution.length; level++) {
+      sum += distribution[level];
+      if (sum >= target) return level;
+    }
+    return 255;
+  };
