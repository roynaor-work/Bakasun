    "opacity": "Multiply alpha only for straight-alpha inputs. Configure alpha-channel blending independently when rendering to a transparent target."
  },
  "rendering": {
    "frameSelection": "Loop: p = elapsedSeconds * fps; i = floor(p) % frameCount; interpolate i and (i+1)%frameCount with p%1. One-shot: min(floor(elapsedSeconds*fps), frameCount-1), then remove at durationSeconds.",
    "interpolation": "Interpolate premultiplied RGBA in a shader or isolated offscreen buffer; do not source-over the two raw frames directly.",
    "threeJS": "UVs above use top-left origin. With Texture.flipY=true, offset.y=1-v-h; repeat=(w,h). Do not mutate UV offset on a texture shared by independently animated sprites; use per-instance UV rectangles.",
    "sorting": "background → soot → heat displacement → flame/extinguish → smoke/steam → embers/sparks → ignition",
    "timing": "Loop rows include 8 different illustrated frames. Premultiplied interpolation smooths the 7→0 transition.",
    "textInArtwork": false
  },
