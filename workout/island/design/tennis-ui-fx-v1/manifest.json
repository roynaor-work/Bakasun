{
  "schemaVersion": 1,
  "id": "tennis-ui-fx-v1",
  "version": "1.0.0",
  "created": "2026-11-14",
  "locale": "he-IL",
  "license": "CC0-1.0",
  "baseCommit": "19d9cdc5e3718236df5a2fc4d8b8c26c72007575",
  "maxFileBytes": 400000,
  "units": {
    "artboard": [
      256,
      256
    ],
    "pngSizes": [
      256,
      512
    ],
    "anchorOrigin": "top-left",
    "anchorConvention": "position = ground/screen point minus anchor * displaySize / 256",
    "rectConvention": "[x,y,width,height] in 256-unit artboard",
    "time": "milliseconds; delta from active simulation, pause aware"
  },
  "palette": {
    "ink": "#173f36",
    "deep": "#102e29",
    "cream": "#f5efdc",
    "brass": "#d4bf82",
    "clay": "#b76c4c",
    "red": "#e15c4f",
    "redDark": "#7c322d",
    "dust": "#e8b68b",
    "dustLight": "#f3d4ac",
    "lime": "#d8df91"
  },
  "style": {
    "reference": "../../minigames/tennis.css",
    "description": "Quiet tournament UI: forest green, cream, brass and clay. Rounded clean strokes, small warm highlights, red only for out/overpower.",
    "provenance": "Original hand-authored SVG geometry; PNGs rasterized from the exact SVG, no external artwork or fonts."
  },
  "integration": {
    "scope": "Asset package and isolated preview only; no gameplay files changed.",
    "textures": {
      "transparent": true,
      "colorSpace": "sRGB",
      "alpha": "straight/unpremultiplied PNG; use renderer-managed premultiplication",
      "depthWrite": false
    },
    "ground": {
      "threeJS": "For already-flattened art (dust/shadow), use screen-projected ground anchors. For out/ring/arrow use an XZ plane at courtY + 0.008 with depthTest:true, depthWrite:false, polygonOffset enabled; reproject the anchor after camera movement.",
      "order": [
        "ball-shadow",
        "line-hit-ring",
        "clay-dust",
        "out-cross",
        "ball",
        "hud"
      ]
    },
    "eventPolicy": "Consume authoritative simulation results. Do not infer out, line hit or net from preview coordinates or change scoring. Preview events are manual demonstrations.",
    "rtl": "Court left/right are physical screen/world directions; never mirror the selection order in RTL.",
    "noTextBaked": true,
    "preload": "Preload the selected PNG resolution before starting a timed event; hold no frame for network loading.",
    "reducedMotion": "Keep the out cross for 1500ms; use dust frame 3 as a static 180ms stamp; snap arrows and remove cosmetic ball motion."
  },
  "effects": {
    "out": {
      "asset": "out-cross",
      "durationMs": 1500,
      "fadeOutMs": 0,
      "loop": false,
      "clock": "active simulation time; hidden at age >= 1500ms",
      "anchorSpace": "court-ground",
      "movement": "fixed contact point, reproject every rendered frame"
    },
    "lineHit": {
      "asset": "line-hit-ring",
      "durationMs": 550,
      "scale": [
        0.82,
        1.12
      ],
      "opacity": [
        1,
        0
      ],
      "loop": false,
      "anchorSpace": "court-ground"
    },
    "serve": {
      "states": [
        {
          "id": "left",
          "asset": "serve-arrow-left",
          "xM": -2.75
        },
        {
          "id": "center",
          "asset": "serve-arrow-center",
          "xM": 0
        },
        {
          "id": "right",
          "asset": "serve-arrow-right",
          "xM": 2.75
        }
      ],
      "nearServiceLineZM": 6.4,
      "transitionMs": 180,
      "wrap": false,
      "input": "ArrowLeft/ArrowRight or touch; clamp index to 0..2. Values are placement suggestions, not service legality rules."
    },
    "dropPower": {
      "track": "drop-meter-track",
      "fill": "drop-meter-fill",
      "needle": "drop-meter-needle",
      "range": [
        0,
        1
      ],
      "fillRect": [
        111,
        32,
        21,
        190
      ],
      "clip": "[111, 222 - 190*p, 21, 190*p]",
      "needleDeltaY": "222 - 190*p - 128",
      "previewSweetRange": [
        0.32,
        0.52
      ],
      "sweetRangePolicy": "Illustrative only. Integrator must supply the real drop-shot range.",
      "placement": "screen edge, respecting safe area; mirror HUD position for left-handed controls, not the scale direction"
    },
    "clayDust": {
      "frames": [
        {
          "asset": "clay-dust-01",
