        {
          "asset": "ball-shadow-mid",
          "heightM": 1.5
        },
        {
          "asset": "ball-shadow-high",
          "heightM": 3
        }
      ],
      "heightRangeM": [
        0,
        3
      ],
      "interpolation": "Clamp height, linearly crossfade adjacent samples (weights sum to 1). All use displaySize 64 and the same ground anchor.",
      "groundLocked": true,
      "hideWhenBallHidden": true
    },
    "signs": {
      "out": {
        "asset": "sign-out",
        "labelHe": "אאוט"
      },
      "net": {
        "asset": "sign-net",
        "labelHe": "נטו"
