  "id": "island-lighting-presets-v1",
  "title": "האי · ערכות תאורה ושמיים",
  "conventions": {
    "coordinates": "Right-handed, +Y up, distances in metres before worldUnitsPerMeter scaling.",
    "sunDirection": "Unit vector FROM the origin TOWARDS the sun/moon; light rays travel in the opposite direction.",
    "colors": "sRGB #RRGGBB; Three.Color converts to linear working space. PNG alpha is straight.",
    "intensity": "Three.js r160 light intensities; directional/hemisphere relative, spots in candela with inverse-square decay.",
    "fog": "Linear view-space depth fog: 0 before start, 1 after end, matching THREE.Fog.",
    "sky": "Analytic gradient in linear RGB; ground below -0.15 elevation, horizon at 0, upper at 0.35, zenith at 1.",
    "weather": "Particles in a 64 x 36 x 64 metre volume. GPU motion; weather does not change ground materials.",
    "spotlights": "Positions/targets in metres; scale intensity by worldUnitsPerMeter squared to retain illuminance.",
    "filePreview": "preset-data.js is a build-generated exact copy of this JSON and PNG data URLs; no fetch is required."
  },
