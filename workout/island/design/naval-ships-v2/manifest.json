  "rig": {
    "turret": {
      "axis": "+Y",
      "yawLimitsDegrees": [
        -150,
        150
      ]
    },
    "barrel": {
      "axis": "+X",
      "pitchLimitsDegrees": [
        -35,
        5
      ]
    },
    "muzzle": {
      "parent": "barrel",
      "forward": "+Z"
    },
    "funnel": {
      "anchor": "exhaust"
    },
    "radar": {
      "clip": "radar_spin",
      "axis": "+Y",
      "periodSeconds": 4
    },
    "lights": {
      "children": [
        "port_light",
        "starboard_light",
        "mast_light",
        "stern_light"
      ],
      "type": "emissive mesh; no punctual lights; toggle group.visible"
    },
    "cruiserAdditionalRig": [
      "turret_aft",
      "barrel_aft",
      "muzzle_aft"
    ]
  },
  "source": {
    "file": "source/build.py",
    "requires": [
      "Python 3",
      "NumPy"
    ]
  },
  "integration": {
    "runtimeModified": false,
    "loader": "standard GLTFLoader, no decoders",
    "previewDependencies": [
      "../../vendor/three.module.js",
      "../../vendor/GLTFLoader.js"
    ],
    "offline": "serve the repository over HTTP; all resources are same-origin",
    "animation": "AnimationMixer.clipAction(radar_spin).play(); update mixer with seconds",
    "scale": "preserve metre units; ships have deliberately stylized proportions",
    "poolReset": "stop mixer, restore rest transforms (including aft turret yaw PI) and lights visibility"
  },
