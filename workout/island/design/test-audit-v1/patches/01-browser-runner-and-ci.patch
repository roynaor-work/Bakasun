+++ b/tests/helpers/run-browser-suites.mjs
@@ -0,0 +1,72 @@
+import {spawn} from 'node:child_process';
+import {mkdir} from 'node:fs/promises';
+import {fileURLToPath} from 'node:url';
+import path from 'node:path';
+const root=fileURLToPath(new URL('../../',import.meta.url));
+const groups={
+  "alpine": [
+    "tests/island-alpine-ctrl-ski.test.mjs",
+    "tests/island-alpine-env.test.mjs",
+    "tests/island-alpine-ski-assets.test.mjs",
+    "tests/island-alpine-v7.test.mjs"
+  ],
+  "soccer": [
+    "tests/island-soccer-design-controls-browser.test.mjs",
+    "tests/island-soccer-look-v10.test.mjs",
+    "tests/island-soccer-motion2-browser.test.mjs",
+    "tests/island-soccer-reopen-browser.test.mjs",
+    "tests/island-soccer-v3-offline-browser.test.mjs",
+    "tests/island-soccer-v4-turf.test.mjs",
+    "tests/island-soccer-v5-characters.test.mjs",
+    "tests/island-soccer-v7-characters.test.mjs",
+    "tests/island-soccer-v8-connect.test.mjs"
+  ],
+  "other": [
+    "tests/bakasun-a11y-browser.mjs",
+    "tests/island-city-preview.test.mjs",
+    "tests/island-defense-v7.test.mjs",
+    "tests/island-load-rescue-browser.test.mjs",
+    "tests/island-naval-v7.test.mjs",
+    "tests/island-offline-browser.test.mjs",
+    "tests/island-racing-v7-browser.test.mjs",
+    "tests/island-tennis-session-browser.test.mjs",
+    "tests/island-tennis-v7-browser.test.mjs",
+    "tests/island-upgrade-offer-browser.test.mjs",
+    "tests/north-browser.mjs",
+    "tests/workout-royiki.test.mjs",
+    "tests/island-v24-default-browser.test.mjs",
+    "tests/island-racing-v24-render-browser.test.mjs"
+  ],
+  "csp": [
+    "tests/island-browser-csp.test.mjs"
+  ],
+  "v24": [
+    "workout/island/tests/aliens-naval-v24-browser.mjs",
+    "workout/island/tests/fire-v24-browser.mjs",
+    "workout/island/tests/naval-v241-browser.mjs",
+    "workout/island/tests/boar-fx-v241-browser.mjs",
+    "workout/island/tests/tennis-aliens-v24-1-browser.mjs",
+    "workout/island/tests/racing-v24-touch-browser.mjs"
+  ]
+};
+const selected=process.argv[2]||'all';
+if(selected!=='all'&&!groups[selected])throw Error('Unknown browser group: '+selected);
+const files=selected==='all'?Object.entries(groups).filter(([k])=>k!=='v24').flatMap(([,v])=>v):groups[selected];
+const base=path.resolve(process.env.ISLAND_CSP_AUDIT_DIR||'artifacts/browser');
+let failures=0;
+for(const [index,file] of files.entries()){
+ const artifacts=path.join(base,path.basename(file,'.mjs'));await mkdir(artifacts,{recursive:true});
+ console.log(`[${index+1}/${files.length}] ${file}`);
+ const env={...process.env,ISLAND_CSP_BROWSER:'1',ISLAND_SOCCER_BROWSER:'1',ISLAND_CITY_PREVIEW_BROWSER:'1',ISLAND_WORKOUT_BROWSER:'1',ISLAND_CSP_AUDIT_DIR:artifacts};
+ // One software WebGL process per worker. Separate CI jobs provide parallelism.
+ const args=selected==='v24'?[file]:['--test','--test-concurrency=1',file];
+ const child=spawn(process.execPath,args,{cwd:root,env,stdio:'inherit',detached:process.platform!=='win32'});
+ const stop=signal=>{try{if(process.platform==='win32')child.kill(signal);else process.kill(-child.pid,signal);}catch(error){if(error.code!=='ESRCH')throw error;}};
+ let timedOut=false,killTimer;
+ const timer=setTimeout(()=>{timedOut=true;console.error('Browser suite exceeded 20 minutes: '+file);stop('SIGTERM');killTimer=setTimeout(()=>stop('SIGKILL'),5000);},20*60*1000);
+ const code=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('exit',resolve);}).finally(()=>{clearTimeout(timer);clearTimeout(killTimer);});
+ // Close any renderer that survived an abnormal test-process exit.
+ stop('SIGTERM');
+ if(code!==0||timedOut){failures++;console.error('FAILED '+file+' (exit '+code+')');}
+}
+process.exitCode=failures?1:0;
diff --git a/.github/workflows/browser-behavior.yml b/.github/workflows/browser-behavior.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/browser-behavior.yml
@@ -0,0 +1,26 @@
+name: Browser behavior
+on:
+  pull_request:
+  workflow_dispatch:
+jobs:
+  browser:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        group: [alpine, soccer, other, csp]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - run: npm install --no-save --package-lock=false playwright@1.62.1
+      - run: npx playwright install --with-deps chromium
+      - run: npm run test:browser -- ${{ matrix.group }}
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: browser-${{ matrix.group }}
+          path: artifacts/browser
+          if-no-files-found: warn
