    "preserveTargetScales": true
  },
  "rotationRule": {
    "source": "S_world[b] = S_world[parent] * S_local[b]",
    "target": "T_world[b] = characterWorldRotation * S_world[source] * targetBasisWorldQuaternion[b]; T_local[b] = inverse(T_world[parent]) * T_world[b]",
    "calibration": "For nonterminal mapped bones, C is the shortest arc from target bind segment direction in character space to source canonical rest segment direction. targetBasis = C * targetBindWorld. Hand terminals inherit parent C; foot and head terminals retain target bind orientation.",
    "extraBones": "Shoulder bones have no source track. They follow source Chest world rotation with their own target bind basis, keeping their local translations. Arm world orientation is solved against this actual extra parent; no duplicate arm rotation is applied.",
    "contactRule": "Retarget rotations first; preserve all target segment lengths; use target sole centroids derived from lowest dominant-foot bind vertices, flat target bind foot orientation, and analytic world-space two-bone leg IK. Continuous pelvis projection makes weighted ankle goals reachable before IK. Released-foot collision IK preserves its current orientation and resolves local ground penetration before considering a whole-body lift. Full rendered skinned-mesh floor correction, pelvis correction and any resulting support residual are measured and exposed."
  },
