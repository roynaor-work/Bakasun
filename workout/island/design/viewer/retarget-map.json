    ],
    "sourceLegChainMeters": 0.78,
    "formula": "mean(target hip-knee + knee-ankle length) / source hip-knee-ankle length",
    "appliesTo": [
      "hipsOffsetMeters",
      "referenceRootTranslationMeters",
      "supportContacts.anchorMeters"
