    ],
    [
      0.2,
      0.6
    ],
    [
      0.75,
      0.4
    ],
    [
      1,
      0
    ]
  ],
  "reduceMotion": {
    "respectUserPreference": true,
    "prefersReducedMotionAction": "disable",
    "policy": "Disable streaks when prefers-reduced-motion is active; retain colour and HUD icon feedback."
  },
  "render": {
    "blending": "normal",
    "depthTest": true,
    "depthWrite": false,
    "texture": null
  }
